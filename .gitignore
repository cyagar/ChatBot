.env
backend/.env
backend/.env.test
__pycache__/
*.pyc
.pytest_cache/
data/db/*.db
data/app.db
data/object_storage/*
!data/object_storage/.gitkeep
data/reports/*
!data/reports/.gitkeep
data/gdrive_cache/*
!data/gdrive_cache/.gitkeep
# Raw manual corpus: large, proprietary third-party equipment-manufacturer
# content -- never belongs in git history (see the 2026-08-21 history rewrite
# that removed a 255MB source zip + 71 PDFs committed here by mistake).
data/manuals_incoming/*
!data/manuals_incoming/.gitkeep
*.zip
# Google service-account credentials (Drive ingestion) -- a private key file,
# same trust tier as backend/.env. Never commit.
backend/*.json
# Phase 1's published OpenAPI contract (scripts/export_openapi.py) is not a
# secret -- it's meant to be committed and diffed, unlike everything else
# this rule blocks.
!backend/openapi.json
.claude/
.idea/
_pipcheck/
.venv/
node_modules/
*.egg-info/
.neon
.mcp.json
