# Copy this file to local.properties (already gitignored -- never commit it)
# and fill in whichever keys you need. Any key left out falls back to its
# default; see app/build.gradle.kts's resolveBaseUrl() for the exact logic.
# An environment variable of the matching name (see below) overrides
# whatever is set here, which is what CI should use instead of a file.

# sdk.dir is normally written here automatically by Android Studio on sync.
# sdk.dir=C:\\Users\\you\\AppData\\Local\\Android\\Sdk

# Debug build's BASE_URL. Defaults to 10.0.2.2 (the Android emulator's
# host-loopback alias) if unset -- works out of the box for an emulator.
# A physical device on your LAN needs this set to your dev machine's LAN IP.
# Env var override: TECHMANUAL_BASE_URL_DEBUG
# techManual.baseUrl.debug=http://192.168.1.50:8000/

# Release build's BASE_URL. No working default -- assembleRelease/
# bundleRelease fail until this (or the env var) names a real https://
# endpoint, so a placeholder can never ship silently.
# Env var override: TECHMANUAL_BASE_URL_RELEASE
# techManual.baseUrl.release=https://api.example.com/

# Release signing key. All four required together, or assembleRelease/
# bundleRelease fail loudly (verifyReleaseSigningConfig) rather than
# silently falling back to an unsigned/debug-style build. storeFile is
# resolved relative to the android/ project root. Generate a keystore with:
#   keytool -genkeypair -keystore android/keystore/release.jks \
#     -alias <your-alias> -keyalg RSA -keysize 2048 -validity 10000
# Never commit the keystore file itself (android/.gitignore already blocks
# /keystore/, *.jks, *.keystore) -- back it up somewhere durable outside
# this machine, since losing it means no future update can ever replace an
# already-installed release build.
# Env var overrides: TECHMANUAL_RELEASE_STORE_FILE, TECHMANUAL_RELEASE_STORE_PASSWORD,
#                     TECHMANUAL_RELEASE_KEY_ALIAS, TECHMANUAL_RELEASE_KEY_PASSWORD
# techManual.release.storeFile=keystore/release.jks
# techManual.release.storePassword=
# techManual.release.keyAlias=
# techManual.release.keyPassword=
