<network-security-config>
    <!-- Dev machine's LAN IP (update if it changes) and the Android emulator's
         host loopback alias. Cleartext is permitted only for these exact
         hosts, only in debug builds; everything else still requires TLS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.71</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
