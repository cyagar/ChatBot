<network-security-config>
    <!-- Dev machine's LAN IP (update if it changes), the Android emulator's
         host loopback alias, and on-device localhost (instrumented tests
         point ApiClient.initForTest at a MockWebServer instance running in
         the test process on the device itself; see AppNavSessionExpiryTest).
         Cleartext is permitted only for these exact hosts, only in debug
         builds; everything else still requires TLS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.1.71</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
