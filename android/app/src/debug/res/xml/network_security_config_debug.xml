<network-security-config>
    <!-- BASE_URL (app/build.gradle.kts) is configurable per
         developer/CI via local.properties or an env var, with no fixed set
         of hosts known at build time; a per-host allowlist here would
         defeat that (a new LAN IP would need a source edit here too, even
         though build.gradle.kts needs none). Cleartext is instead permitted
         broadly, but only for this debug-only build type (this file lives
         under src/debug/), so it never affects a release build, which keeps
         the default HTTPS-only policy untouched. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
