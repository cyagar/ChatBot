# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
SESSION_TTL_MINUTES=480

# --- Storage ---
# "local" now; swap to "s3" (or equivalent private object storage) in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../data/object_storage
DB_PATH=../data/db/app.db

# --- Document source ---
# "local_directory" now; swap to "google_drive" once the production Drive folder is ready.
DOCUMENT_SOURCE=local_directory
LOCAL_MANUALS_DIR=../data/manuals_incoming
# Populated when DOCUMENT_SOURCE=google_drive:
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- AI provider (answer generation) ---
# "local_extractive" requires no key and returns passage-grounded answers without
# an LLM call. Switch to "anthropic" or "openai" once a key is supplied.
AI_PROVIDER=local_extractive
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- OCR (optional; leave unset until Tesseract is installed) ---
# Windows default install path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
