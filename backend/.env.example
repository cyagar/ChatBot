# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
# REPLACE_ME is deliberately short (fails validate_for_startup's length
# check) AND on the explicit known-placeholder rejection list
# (app/config.py's _KNOWN_INSECURE_SECRET_KEYS) -- generate a real random
# secret per environment (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
# and never copy this line verbatim into a real .env. A deployment that
# ever booted with a known placeholder must rotate SECRET_KEY, which
# invalidates every existing session.
SECRET_KEY=REPLACE_ME
SESSION_TTL_MINUTES=480

# --- Object storage ---
# Raw manual files (originals + page-image cache) live on local disk under
# LOCAL_STORAGE_DIR, resolved relative to backend/. The single-host deployment
# (docker-compose.yml) bind-mounts ./data at this path, so it survives a
# container restart/rebuild. On any host where this directory is NOT durable
# storage (an ephemeral container filesystem with nothing mounted at this
# path), citation evidence and page images do not survive a restart -- mount
# durable storage at this path first.
LOCAL_STORAGE_DIR=../data/object_storage

# --- Database ---
# Postgres/Neon connection strings. Use DATABASE_URL (pooled, -pooler host)
# for normal app traffic; DATABASE_URL_UNPOOLED (direct host) for schema
# migrations, pg_dump/restore, or anything needing session state -- never
# swap these. Both are required; the app will not start without them.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Document source ---
# Google Drive is the only document source -- there is no local-directory
# fallback. The folder ID is the string in the folder's URL
# (drive.google.com/drive/folders/<THIS_PART>); the folder must be shared
# (Viewer is enough) with the service account's client_email.
GOOGLE_DRIVE_FOLDER_ID=
# Path to a downloaded service-account key file, relative to backend/ (or
# absolute). Never put the key's actual JSON content in this .env file --
# keep it as its own file and just point here. That file must stay
# git-ignored (see backend/*.json in .gitignore).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GDRIVE_CACHE_DIR=../data/gdrive_cache
# Guardrail against a pathological single file (e.g. a multi-GB file dropped
# in by mistake) -- not a corpus size limit. A file over this is skipped (not
# downloaded) and reported in the ingestion report rather than silently
# dropped. No file-count limit exists: it would make a large folder look
# identical to files having been removed from Drive.
MAX_DRIVE_FILE_SIZE_MB=200
# Automated corpus freshness: a background loop calls the same sync path as
# "Run re-index now" every N minutes. 0 disables it (also auto-disabled
# whenever GOOGLE_DRIVE_FOLDER_ID above is blank). After a start, the first
# sync runs about a minute later if the corpus is stale or has never synced,
# otherwise when the current interval elapses.
INGESTION_SYNC_INTERVAL_MINUTES=360
# The admin UI flags the corpus as stale if no successful sync has completed
# within this many hours -- comfortably above the interval above so one or
# two missed/slow ticks don't alarm.
INGESTION_STALENESS_THRESHOLD_HOURS=48

# --- AI provider (answer generation) ---
# "local_extractive" requires no key and returns passage-grounded answers without
# an LLM call. Switch to "anthropic" once a key is supplied.
AI_PROVIDER=local_extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Writes rejected model responses (manual excerpts, technician questions) to the log.
LOG_REJECTED_MODEL_OUTPUT=false

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned commit SHA (not "main") -- baked into the Docker image at build time.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# --- OCR (optional; leave unset until Tesseract is installed) ---
# Windows default install path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Ingestion resource guardrails ---
# Bounds against a pathological PDF/image consuming unbounded CPU/memory
# during ingestion or page-image rendering.
MAX_PDF_PAGES=2000
MAX_PAGE_RENDER_PIXELS=40000000
OCR_TIMEOUT_SECONDS=30
# Total size of the in-memory rendered-page cache (per process).
PAGE_IMAGE_CACHE_MB=64

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60
# Hosts allowed to set X-Forwarded-For (comma-separated, or "*" for any).
# Leave at the default (trust only a proxy on localhost) unless this process
# is only ever reachable through a specific reverse proxy -- see
# docker-compose.prod.yml for the single-host deployment's value.
TRUSTED_PROXY_IPS=127.0.0.1

# --- Access control ---
# Comma-separated email domains an administrator is allowed to invite, e.g.
# "hmwagner.com,contractor-partner.com" (registration itself always requires
# an admin-issued invitation -- there is no public self-registration). Leave
# empty only for local dev -- empty means an admin could invite any email
# address at all, with nothing restricting which domains reach the library.
ALLOWED_REGISTRATION_DOMAINS=

# --- Runtime status (GET /api/config) ---
# Read by the Android client, enforced there, not by the backend -- see
# app/config.py. A maintenance banner and a minimum-version nudge are both
# purely advisory: nothing server-side blocks a request based on these.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
# MINIMUM_SUPPORTED_VERSION is a human-readable label only. The Android
# client actually blocks on MINIMUM_SUPPORTED_VERSION_CODE against its own
# versionCode -- versionName alone can't be compared reliably (this app's
# own versionName stayed "1.0.0" across versionCode 2 through 6). 0 (the
# default) means unset: nothing blocks. Keep both in sync by hand with
# android/app/build.gradle.kts's versionName/versionCode.
MINIMUM_SUPPORTED_VERSION=1.0.0
MINIMUM_SUPPORTED_VERSION_CODE=0
# A real support inbox/URL for this deployment -- the app/config.py default
# is a placeholder, not a live inbox.
SUPPORT_CONTACT=support@hmwagner.com
# Non-blocking update notice: leave these blank/0 to keep the app silent
# about updates. Set LATEST_VERSION (display text), LATEST_VERSION_CODE
# (what's actually compared against the client's versionCode) and
# UPDATE_URL together to advertise a newer build.
LATEST_VERSION=
LATEST_VERSION_CODE=0
UPDATE_URL=
