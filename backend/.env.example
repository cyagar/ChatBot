# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-64-char-string
SESSION_TTL_MINUTES=480

# --- Storage ---
# "local" now; swap to "s3" (or equivalent private object storage) in production.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../data/object_storage
DB_PATH=../data/db/app.db

# --- Document source ---
# Google Drive is the only document source -- there is no local-directory
# fallback. The folder ID is the string in the folder's URL
# (drive.google.com/drive/folders/<THIS_PART>); the folder must be shared
# (Viewer is enough) with the service account's client_email.
GOOGLE_DRIVE_FOLDER_ID=
# Path to a downloaded service-account key file, relative to backend/ (or
# absolute). Never put the key's actual JSON content in this .env file --
# keep it as its own file and just point here. That file must stay
# git-ignored (see backend/*.json in .gitignore).
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=
GDRIVE_CACHE_DIR=../data/gdrive_cache

# --- AI provider (answer generation) ---
# "local_extractive" requires no key and returns passage-grounded answers without
# an LLM call. Switch to "anthropic" or "openai" once a key is supplied.
AI_PROVIDER=local_extractive
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Pinned commit SHA (not "main") -- baked into the Docker image at build time.
EMBEDDING_MODEL_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# --- OCR (optional; leave unset until Tesseract is installed) ---
# Windows default install path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Access control ---
# Comma-separated email domains allowed to self-register, e.g.
# "hmwagner.com,contractor-partner.com". Leave empty only for local dev —
# empty means anyone can register and reach the manual library.
ALLOWED_REGISTRATION_DOMAINS=
